# Project Configuration
#
# This file defines the locations of your development projects.
# Copy this file to config/projects.env and customize for your machine.
#
# Usage:
#   source "$DOTFILES_DIR/config/projects.env"
#   cd "$VETS_API_DIR"
#
# Note: config/projects.env is git-ignored to support machine-specific paths

# ============================================================================
# VA.gov Projects
# ============================================================================

# Base directory for VA.gov projects
# Default: $HOME/Code/va.gov
VAGOVDEV_BASE="${VAGOVDEV_BASE:-${HOME}/Code/va.gov}"

# Individual VA.gov project directories
VETS_API_DIR="${VETS_API_DIR:-${VAGOVDEV_BASE}/vets-api}"
VETS_WEBSITE_DIR="${VETS_WEBSITE_DIR:-${VAGOVDEV_BASE}/vets-website}"
CONTENT_BUILD_DIR="${CONTENT_BUILD_DIR:-${VAGOVDEV_BASE}/content-build}"
VETS_API_MOCKDATA_DIR="${VETS_API_MOCKDATA_DIR:-${VAGOVDEV_BASE}/vets-api-mockdata}"

# ============================================================================
# Local Overrides (Optional)
# ============================================================================

# For machine-specific overrides, create config/projects.local.env
# This file is also git-ignored and loaded automatically if present
#
# Example projects.local.env:
#   VETS_API_DIR="$HOME/work/va/vets-api"
#   VETS_WEBSITE_DIR="$HOME/work/va/vets-website"

if [ -f "${DOTFILES_DIR:-$HOME/dotfiles}/config/projects.local.env" ]; then
  source "${DOTFILES_DIR:-$HOME/dotfiles}/config/projects.local.env"
fi

# ============================================================================
# Export for use in scripts
# ============================================================================

export VAGOVDEV_BASE
export VETS_API_DIR
export VETS_WEBSITE_DIR
export CONTENT_BUILD_DIR
export VETS_API_MOCKDATA_DIR
